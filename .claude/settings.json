{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(.venv/bin/python tools/smoke_test.py)",
      "Bash(.venv/bin/python --version)",
      "Bash(.venv/bin/python -m pip list)",
      "Bash(.venv/bin/python -m pip show:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(ls:*)",
      "Bash(rg:*)",
      "Bash(wc:*)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:doc.qt.io)",
      "WebFetch(domain:matplotlib.org)",
      "WebFetch(domain:numpy.org)",
      "WebFetch(domain:pillow.readthedocs.io)",
      "WebSearch"
    ],
    "ask": [
      "Bash(.venv/bin/python build_app.py)",
      "Bash(.venv/bin/python opticalFlake_V0.4.py)"
    ],
    "deny": [
      "Edit(./Old_Versions/**)",
      "Write(./Old_Versions/**)"
    ]
  }
}
